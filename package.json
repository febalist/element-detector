{
  "name": "element-detector",
  "version": "0.1.0",
  "description": "Detect elements appearing in the DOM using MutationObserver",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run build && npm test",
    "prepare": "husky"
  },
  "keywords": [
    "dom",
    "mutation",
    "observer",
    "detect",
    "elements",
    "detector",
    "mutation-observer",
    "typescript"
  ],
  "author": "febalist",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/febalist/element-detector.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.0.0",
    "husky": "^9.1.7",
    "jsdom": "^23.0.0",
    "semantic-release": "^25.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
