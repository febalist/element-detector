{
	"name": "element-detector",
	"version": "1.0.0",
	"description": "Detect elements appearing in the DOM using MutationObserver",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check --write .",
		"prepublishOnly": "npm run build && npm test"
	},
	"keywords": [
		"dom",
		"mutation",
		"observer",
		"detect",
		"elements",
		"detector",
		"mutation-observer",
		"typescript"
	],
	"author": "febalist",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/febalist/element-detector.git"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.0",
		"@types/node": "^20.0.0",
		"jsdom": "^23.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.3.0",
		"vitest": "^1.0.0"
	},
	"engines": {
		"node": ">=16"
	}
}
